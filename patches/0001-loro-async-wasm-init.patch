diff --git a/web/app/components/workflow/collaboration/core/loro-runtime.ts b/web/app/components/workflow/collaboration/core/loro-runtime.ts
new file mode 100644
index 0000000..13926c5
--- /dev/null
+++ b/web/app/components/workflow/collaboration/core/loro-runtime.ts
@@ -0,0 +1,33 @@
+type LoroModule = typeof import('loro-crdt') & {
+  initLoroWasm?: () => Promise<unknown>
+}
+
+let runtimePromise: Promise<LoroModule> | null = null
+let runtimeModule: LoroModule | null = null
+
+/** 同步取已初始化的 loro 模块，供 `new LoroMap()` 这类运行时构造使用。 */
+export function getLoroRuntime(): LoroModule {
+  if (!runtimeModule)
+    throw new Error('loro-crdt 尚未初始化，调用前需先 await loadLoroRuntime()')
+  return runtimeModule
+}
+
+/**
+ * loro-crdt 的 browser 入口原本在模块求值阶段就同步编译约 3.1MB 的 wasm。
+ * Chromium < 115 会因此抛 RangeError 并把整个 chunk 打挂，表现为页面提示
+ * “渲染此组件时发生了意外错误”。这里把初始化改成显式异步：先 await
+ * initLoroWasm()（内部走 WebAssembly.compile），再返回模块；调用方拿到
+ * 模块后即可照常同步 new LoroDoc()。
+ */
+export function loadLoroRuntime(): Promise<LoroModule> {
+  if (!runtimePromise) {
+    runtimePromise = (async () => {
+      const mod = (await import('loro-crdt')) as LoroModule
+      if (typeof window !== 'undefined' && typeof mod.initLoroWasm === 'function')
+        await mod.initLoroWasm()
+      runtimeModule = mod
+      return mod
+    })()
+  }
+  return runtimePromise
+}
