diff --git a/patches/loro-crdt@1.13.5.patch b/patches/loro-crdt@1.13.5.patch
new file mode 100644
index 0000000..54c70de
--- /dev/null
+++ b/patches/loro-crdt@1.13.5.patch
@@ -0,0 +1,56 @@
+--- a/browser/loro_wasm.js
++++ b/browser/loro_wasm.js
+@@ -328,9 +328,51 @@
+ }
+ 
+ const wasmUrl = new URL("./loro_wasm_bg.wasm", import.meta.url);
+-const instance = instantiateSync(loadWasmBytesSync(wasmUrl.href), WASM_IMPORTS);
+ 
+-finalize(instance.exports);
++// [legacy-chromium-patch] Chromium < 115 rejects synchronous
++// `new WebAssembly.Module(bytes)` on the main thread for anything above 4KB.
++// The original code ran it at module evaluation time, so importing loro-crdt
++// threw a RangeError and took down every route that touched it.
++// Initialization is now explicit: callers `await initLoroWasm()` before using
++// any exported class. Compilation is async, instantiation stays synchronous,
++// and the compiled module is cached on globalThis for later re-inits.
++let loroInstance = null;
++
++export function isLoroWasmReady() {
++  return loroInstance !== null;
++}
++
++export async function initLoroWasm() {
++  if (loroInstance)
++    return loroInstance;
++
++  let wasmModule = globalThis.__LORO_WASM_MODULE__;
++  if (!wasmModule) {
++    const response = await fetch(wasmUrl.href);
++    if (!response.ok)
++      throw new Error(`Failed to load loro-crdt WASM from ${wasmUrl.href}: ${response.status} ${response.statusText}`);
++    wasmModule = await WebAssembly.compile(await response.arrayBuffer());
++    globalThis.__LORO_WASM_MODULE__ = wasmModule;
++  }
++
++  // `instantiate(Module)` resolves to an Instance; `instantiate(bytes)` resolves
++  // to `{ module, instance }`. Accept both shapes.
++  const instantiated = await WebAssembly.instantiate(wasmModule, WASM_IMPORTS);
++  loroInstance = instantiated.instance || instantiated;
++  finalize(loroInstance.exports);
++  return loroInstance;
++}
++
++// Kept for bundlers that ignore the explicit init path.
++function instantiateLoroSync() {
++  if (loroInstance)
++    return loroInstance;
++
++  loroInstance = instantiateSync(loadWasmBytesSync(wasmUrl.href), WASM_IMPORTS);
++  finalize(loroInstance.exports);
++  return loroInstance;
++}
++export { instantiateLoroSync };
+ 
+ export {
+   AwarenessWasm,
