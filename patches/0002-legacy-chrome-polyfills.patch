+++ b/web/app/polyfill-test/page.tsx
@@ -0,0 +1,67 @@
+'use client'
+
+// [diagnostic] 验证老内核 polyfill 的注入时机，不属于业务功能。
+//
+// 关键点：下面这段 probe 在**模块求值期**执行，早于 React 组件渲染、
+// 也早于任何组件内的 useEffect。如果 polyfill 的注入晚于本模块，
+// 这里会抛 TypeError，整个页面白屏 —— 这个页面本身就是判定器。
+//
+// 上线前可以删掉整个目录。
+const probe = (() => {
+  const results: string[] = []
+  const run = (name: string, fn: () => unknown) => {
+    try {
+      results.push(`${name}=${String(fn())}`)
+    }
+    catch (e) {
+      results.push(`${name}=THROW:${(e as Error)?.name || 'Error'}`)
+    }
+  }
+
+  // 走 any 是为了绕开 lib 版本差异（ES2023/ES2024 方法在部分 tsconfig lib 里没有声明），
+  // 这几行是运行时探针，不需要类型检查给出保证。
+  const P = Promise as any
+  const O = Object as any
+  const M = Map as any
+  const arr = [1, 2, 3] as any
+
+  run('withResolvers', () => typeof P.withResolvers())
+  run('structuredClone', () => (structuredClone({ a: 1 }) as { a: number }).a)
+  run('randomUUID', () => crypto.randomUUID().length)
+  run('groupBy', () => Object.keys(O.groupBy([1, 2, 3], (n: number) => String(n % 2))).join('|'))
+  run('mapGroupBy', () => (M.groupBy([1, 2, 3], (n: number) => n % 2) as Map<number, number[]>).get(1)?.length)
+  run('toSorted', () => arr.toSorted().join(','))
+  run('toReversed', () => arr.toReversed().join(','))
+  run('toSpliced', () => arr.toSpliced(0, 1).join(','))
+  run('with', () => arr.with(0, 9).join(','))
+  run('at', () => [1, 2, 3].at(-1))
+  run('findLast', () => [1, 2, 3].findLast(x => x > 1))
+  run('hasOwn', () => Object.hasOwn({ a: 1 }, 'a'))
+  run('abortAny', () => AbortSignal.any([]) instanceof AbortSignal)
+  run('abortTimeout', () => AbortSignal.timeout(1) instanceof AbortSignal)
+  run('abortStatic', () => AbortSignal.abort() instanceof AbortSignal)
+  run('throwIfAborted', () => typeof (new AbortController().signal as any).throwIfAborted)
+  run('urlCanParse', () => URL.canParse('https://a.b/c'))
+
+  return results
+})()
+
+const PolyfillTestPage = () => {
+  const allOk = probe.every(item => !item.includes('THROW'))
+
+  return (
+    <div className="p-8 system-md-regular">
+      <h1 className="mb-4 system-xl-semibold">Legacy Chrome Polyfill Probe</h1>
+      <p className="mb-4" style={{ color: allOk ? '#12B76A' : '#F04438' }}>
+        {allOk ? 'ALL OK (module-eval time)' : 'FAILED (module-eval time)'}
+      </p>
+      <ul className="flex flex-col gap-1">
+        {probe.map(item => (
+          <li key={item} className="font-mono system-sm-regular">{item}</li>
+        ))}
+      </ul>
+    </div>
+  )
+}
+
+export default PolyfillTestPage
